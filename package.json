{
  "name": "@tigerdata/mcp-boilerplate",
  "version": "1.6.6",
  "description": "MCP boilerplate code for Node.js",
  "license": "Apache-2.0",
  "author": "TigerData",
  "homepage": "https://tigerdata.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/timescale/mcp-boilerplate-node"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./eslintPlugin": {
      "import": "./dist/eslintPlugin.js",
      "types": "./dist/eslintPlugin.d.ts"
    },
    "./instrumentation": {
      "import": "./dist/instrumentation.js",
      "types": "./dist/instrumentation.d.ts"
    },
    "./skills": {
      "import": "./dist/skills/index.js",
      "types": "./dist/skills/index.d.ts"
    },
    "./migrate": {
      "import": "./dist/migrate.js",
      "types": "./dist/migrate.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "tsc",
    "watch": "tsc --watch",
    "lint": "./bun x @biomejs/biome check",
    "test": "./bun test ./src",
    "check": "tsc --noEmit && ./bun --silent lint --write && ./bun --silent run test --only-failures",
    "release": "bump-release"
  },
  "dependencies": {
    "@mcp-use/inspector": "^20.3.22",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@toon-format/toon": "^4.4.0",
    "escape-html": "^1.0.3",
    "express": "^5.3.0",
    "gray-matter": "^4.0.3",
    "raw-body": "^4.0.0",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "migrate": "^2.1.0",
    "pg": "^8.16.3",
    "zod": "^3.25 || ^4.0"
  },
  "peerDependenciesMeta": {
    "migrate": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@octokit/rest": "^22.0.1",
    "@tigerdata/bump-release": "^0.1.2",
    "@types/bun": "^1.4.3",
    "@types/escape-html": "^1.0.4",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@typescript-eslint/typescript-estree": "^8.72.0",
    "ai": "^7.0.147",
    "eslint": "^10.13.0",
    "migrate": "^2.1.0",
    "pg": "^8.23.1",
    "typescript": "^6.0.3",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
